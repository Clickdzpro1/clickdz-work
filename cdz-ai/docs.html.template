};
const tabs=document.getElementById('tabs'),cbs=document.getElementById('codeblocks');
Object.keys(CODE).forEach((k,idx)=>{
  const t=document.createElement('div');t.className='tab'+(idx===0?' active':'');t.textContent=k;t.onclick=()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.codeblock').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');document.getElementById('cb-'+k).classList.add('active');
  };tabs.appendChild(t);
  const b=document.createElement('pre');b.className='codeblock'+(idx===0?' active':'');b.id='cb-'+k;b.innerHTML='<code>'+CODE[k]+'</code>';cbs.appendChild(b);
});

// scroll reveal
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// counters
function animateCount(el,to,suffix,dec){let s=null;const dur=1400;const step=t=>{if(!s)s=t;const p=Math.min((t-s)/dur,1);const v=(to*p);el.textContent=(dec?v.toFixed(1):Math.round(v))+suffix;if(p<1)requestAnimationFrame(step);};requestAnimationFrame(step);}
const cio=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){const id=e.target.id;if(id==='c1')animateCount(e.target,7,'');if(id==='c2')animateCount(e.target,40,'',false);if(id==='c3')animateCount(e.target,99.9,'',true);cio.unobserve(e.target);}}),{threshold:.5});
['c1','c2','c3'].forEach(id=>{const el=document.getElementById(id);if(el)cio.observe(el);});

// pointer tilt on model cards
document.addEventListener('pointermove',e=>{
  const card=e.target.closest('.mcard');if(!card)return;
  const r=card.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5;const y=(e.clientY-r.top)/r.height-.5;
  card.style.transform=`translateY(-6px) rotateX(${(-y*6).toFixed(2)}deg) rotateY(${(x*6).toFixed(2)}deg)`;
});
document.addEventListener('pointerout',e=>{const card=e.target.closest&&e.target.closest('.mcard');if(card)card.style.transform='';});
</script>
