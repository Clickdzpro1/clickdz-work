<style>
  :root{
    --bg:#070711; --bg2:#0b0b18; --panel:#101024; --panel2:#15152c;
    --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.14);
    --text:#f2f2f8; --muted:#a6a6c2; --dim:#6f6f90;
    --cdz:#2f7bff; --cdz2:#57a6ff; --violet:#8b5cff; --cyan:#22d3ee; --pink:#ff5ea8;
    --radius:18px; --maxw:1140px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  h1,h2,h3{font-family:Sora,Inter,sans-serif;letter-spacing:-.02em;margin:0}
  code,pre{font-family:'JetBrains Mono',monospace}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .grad{background:linear-gradient(110deg,var(--cdz2),var(--violet) 45%,var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}

  /* animated background */
  .bg{position:fixed;inset:0;z-index:-2;background:
      radial-gradient(closest-side at 50% 50%,rgba(255,255,255,.03),transparent) ,var(--bg)}
  .blob{position:fixed;z-index:-1;filter:blur(90px);opacity:.5;border-radius:50%;will-change:transform}
  .b1{width:520px;height:520px;background:radial-gradient(circle,#2f7bff,transparent 65%);top:-160px;left:-120px;animation:float1 18s ease-in-out infinite}
  .b2{width:460px;height:460px;background:radial-gradient(circle,#8b5cff,transparent 65%);top:10%;right:-140px;animation:float2 22s ease-in-out infinite}
  .b3{width:420px;height:420px;background:radial-gradient(circle,#22d3ee,transparent 65%);bottom:-160px;left:30%;animation:float3 20s ease-in-out infinite}
  @keyframes float1{50%{transform:translate(80px,60px) scale(1.1)}}
  @keyframes float2{50%{transform:translate(-70px,50px) scale(1.15)}}
  @keyframes float3{50%{transform:translate(50px,-60px) scale(1.05)}}
  .grid-overlay{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.35;
    background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:54px 54px;mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 30%,transparent 75%)}

  /* nav */
  nav{position:sticky;top:0;z-index:50;transition:background .3s,border-color .3s,backdrop-filter .3s;border-bottom:1px solid transparent}
  nav.scrolled{background:rgba(7,7,17,.72);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  .nav-in{display:flex;align-items:center;gap:14px;padding:14px 0}
  .brand{display:flex;align-items:center;gap:11px;font-family:Sora;font-weight:800;font-size:18px}
  .brand img{width:34px;height:34px;border-radius:9px;box-shadow:0 4px 18px rgba(47,123,255,.4)}
  .nav-links{display:flex;gap:26px;margin-left:24px}
  .nav-links a{color:var(--muted);font-size:14px;font-weight:500;transition:color .18s}
  .nav-links a:hover{color:var(--text)}
  .nav-cta{margin-left:auto;display:flex;gap:10px;align-items:center}
  .btn{display:inline-flex;align-items:center;gap:9px;font-weight:600;font-size:14px;padding:11px 20px;border-radius:12px;border:1px solid var(--line2);transition:transform .16s,box-shadow .16s,background .16s;cursor:pointer}
  .btn:hover{transform:translateY(-2px)}
  .btn.primary{background:linear-gradient(120deg,var(--cdz),var(--violet));border-color:transparent;box-shadow:0 8px 30px rgba(80,90,255,.4)}
  .btn.primary:hover{box-shadow:0 12px 42px rgba(80,90,255,.6)}
  .btn.wa{background:linear-gradient(120deg,#25d366,#128c4b);border-color:transparent;box-shadow:0 8px 30px rgba(37,211,102,.35)}
  .btn.ghost{background:rgba(255,255,255,.04)}
  .nav-links,.nav-cta .ghost{}
  @media(max-width:820px){.nav-links{display:none}.nav-cta .ghost{display:none}}

  /* hero */
  .hero{position:relative;text-align:center;padding:90px 0 70px}
  .badge{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;color:var(--cdz2);background:rgba(47,123,255,.1);border:1px solid rgba(47,123,255,.3);padding:7px 15px;border-radius:999px;margin-bottom:30px}
  .badge .dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.7);animation:pulse 2s infinite}
  @keyframes pulse{70%{box-shadow:0 0 0 10px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
  .hero h1{font-size:clamp(42px,7.5vw,88px);font-weight:800;line-height:1.02;margin-bottom:8px}
  .rot{display:inline-block;min-height:1.05em}
  .hero .sub{font-size:clamp(17px,2.3vw,22px);color:var(--muted);max-width:680px;margin:22px auto 20px}
  .hero-logo{width:150px;height:150px;margin:6px auto 30px;position:relative}
  .hero-logo img{width:100%;height:100%;border-radius:32px;position:relative;z-index:2;box-shadow:0 20px 70px rgba(47,123,255,.55);animation:bob 5s ease-in-out infinite}
  @keyframes bob{50%{transform:translateY(-12px)}}
  .ring{position:absolute;inset:-26px;border:1.5px solid rgba(87,166,255,.35);border-radius:50%;animation:spin 14s linear infinite}
  .ring:nth-child(2){inset:-52px;border-color:rgba(139,92,255,.22);animation-duration:22s;animation-direction:reverse}
  @keyframes spin{to{transform:rotate(360deg)}}
  .cta-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:8px}
  .trust{display:flex;gap:34px;justify-content:center;flex-wrap:wrap;margin-top:44px;color:var(--dim);font-size:13px}
  .trust b{color:var(--text);font-family:Sora;font-size:20px;display:block}

  /* marquee */
  .marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0;margin-top:20px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .marquee-track{display:flex;gap:54px;white-space:nowrap;animation:scroll 26s linear infinite;font-family:Sora;font-weight:700;font-size:19px;color:var(--dim)}
  .marquee-track span{opacity:.8}
  @keyframes scroll{to{transform:translateX(-50%)}}

  section{padding:84px 0}
  .eyebrow{text-align:center;font-size:12.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--cdz2);margin-bottom:14px}
  .h2{text-align:center;font-size:clamp(30px,4.5vw,46px);font-weight:800;margin-bottom:16px}
  .lead{text-align:center;color:var(--muted);max-width:620px;margin:0 auto 52px;font-size:17px}

  /* reveal */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  .reveal.in{opacity:1;transform:none}

  /* models */
  .models{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}
  .mcard{position:relative;background:linear-gradient(180deg,var(--panel),var(--bg2));border:1px solid var(--line);border-radius:var(--radius);padding:26px;overflow:hidden;transition:transform .25s,border-color .25s}
  .mcard::before{content:"";position:absolute;inset:0;padding:1px;border-radius:var(--radius);background:linear-gradient(130deg,var(--cdz),var(--violet),var(--cyan));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .25s}
  .mcard:hover{transform:translateY(-6px)}
  .mcard:hover::before{opacity:1}
  .mcard .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .micon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:Sora;font-weight:800;font-size:17px}
  .ver{font-family:'JetBrains Mono';font-size:12px;font-weight:600;color:var(--cdz2);background:rgba(47,123,255,.12);border:1px solid rgba(47,123,255,.28);padding:3px 9px;border-radius:8px}
  .ver.flag{color:#ffd479;background:rgba(255,196,80,.1);border-color:rgba(255,196,80,.3)}
  .mcard h3{font-size:20px;margin-bottom:6px}
  .mcard p{color:var(--muted);font-size:14px;margin:0}
  .mcard .id{margin-top:14px;font-family:'JetBrains Mono';font-size:11.5px;color:var(--dim)}

  /* features */
  .feats{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
  .feat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .2s,border-color .2s}
  .feat:hover{transform:translateY(-4px);border-color:var(--line2)}
  .feat .fi{font-size:26px;margin-bottom:12px}
  .feat h3{font-size:17px;margin-bottom:6px}
  .feat p{color:var(--muted);font-size:14px;margin:0}

  /* code */
  .code-wrap{max-width:820px;margin:0 auto;background:#0a0a16;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .tabs{display:flex;gap:2px;background:rgba(255,255,255,.03);border-bottom:1px solid var(--line);padding:8px 8px 0}
  .tab{padding:9px 16px;font-size:13px;font-weight:600;color:var(--dim);cursor:pointer;border-radius:9px 9px 0 0;transition:color .16s,background .16s}
  .tab.active{color:var(--text);background:#0a0a16}
  pre{margin:0;padding:22px 24px;overflow-x:auto;font-size:13px;line-height:1.7}
  pre .k{color:var(--violet)} pre .s{color:#7ee0b8} pre .c{color:var(--dim)} pre .f{color:var(--cdz2)}
  .codeblock{display:none} .codeblock.active{display:block}

  /* cta band */
  .band{position:relative;text-align:center;background:linear-gradient(120deg,rgba(47,123,255,.14),rgba(139,92,255,.14));border:1px solid var(--line2);border-radius:26px;padding:60px 30px;overflow:hidden}
  .band h2{font-size:clamp(28px,4vw,42px);font-weight:800;margin-bottom:14px}
  .band p{color:var(--muted);max-width:520px;margin:0 auto 28px;font-size:17px}
  .price{font-family:Sora;font-size:15px;color:var(--dim);margin-top:18px}

  footer{border-top:1px solid var(--line);padding:46px 0 60px;color:var(--dim);font-size:13.5px}
  .foot-in{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .foot-in img{width:30px;height:30px;border-radius:8px}
  .foot-in .sp{margin-left:auto;display:flex;gap:20px}
  .foot-in a:hover{color:var(--text)}
</style>
</head>
