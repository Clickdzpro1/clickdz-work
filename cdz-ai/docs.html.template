<script>
// rotating hero word
const words=['unified.','on tap.','one API.','your edge.','unleashed.'];let wi=0;
const rot=document.getElementById('rot');
setInterval(()=>{wi=(wi+1)%words.length;rot.style.opacity=0;setTimeout(()=>{rot.textContent=words[wi];rot.style.opacity=1;},220);},2400);
rot.style.transition='opacity .22s';

// nav blur
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>20));

// year
document.getElementById('yr').textContent=new Date().getFullYear();

// models data — versions hint the engine tier without naming vendors
const MODELS=[
  {n:'CDZ Ultra',v:'AUTO',flag:1,i:'∞',c:'linear-gradient(135deg,#2f7bff,#8b5cff)',d:'Our adaptive flagship. Reads your intent and routes to the perfect specialist in real time — you never pick wrong.',id:'cdz-ultra'},
  {n:'CDZ Council',v:'×3',flag:1,i:'⚖',c:'linear-gradient(135deg,#8b5cff,#ff5ea8)',d:'Three elite minds answer in parallel, then a synthesis reconciles them into one decisive verdict. For decisions that matter.',id:'cdz-council'},
  {n:'CDZ Sage',v:'4.8',i:'S',c:'linear-gradient(135deg,#d97757,#ffb27a)',d:'Deep reasoning, nuance and hard tradeoffs. The mind you bring to strategy, ethics and the hardest questions.',id:'cdz-sage'},
  {n:'CDZ Architect',v:'5.5',i:'A',c:'linear-gradient(135deg,#10a37f,#3dd7ad)',d:'Production-grade code and systems design. Ships complete, correct builds — not sketches.',id:'cdz-architect'},
  {n:'CDZ Scholar',v:'3.1',i:'R',c:'linear-gradient(135deg,#2f7bff,#57a6ff)',d:'Research, structure and long-form mastery. Turns chaos into crisp, cited, organized knowledge.',id:'cdz-scholar'},
  {n:'CDZ Flash',v:'3.5',i:'F',c:'linear-gradient(135deg,#22d3ee,#4ea8ff)',d:'Instant answers at blistering speed for everyday work. Lean, fast, always ready.',id:'cdz-flash'},
  {n:'CDZ Polyglot',v:'5.4',i:'P',c:'linear-gradient(135deg,#8b5cff,#c39bff)',d:'Native-level Arabic, French and English — Darija included. Speaks your market fluently.',id:'cdz-polyglot'},
];
const mg=document.getElementById('modelGrid');
mg.innerHTML=MODELS.map(m=>`<div class="mcard reveal">
  <div class="top"><div class="micon" style="background:${m.c}">${m.i}</div><span class="ver ${m.flag?'flag':''}">${m.v}</span></div>
  <h3>${m.n}</h3><p>${m.d}</p><div class="id">model: ${m.id}</div></div>`).join('');

// features
const FEATS=[
  {i:'🔌',h:'OpenAI-compatible',d:'/v1/chat/completions and /v1/models. Your existing SDK just works — change one URL.'},
  {i:'⚡',h:'Streaming',d:'Token-by-token SSE streaming for snappy, real-time experiences.'},
  {i:'👁️',h:'Vision',d:'Send an image URL and any model can see, read and reason over it.'},
  {i:'🎙️',h:'Audio',d:'Transcribe speech in 20 languages, including Arabic and French.'},
  {i:'🧭',h:'Smart routing',d:'CDZ Ultra auto-selects the ideal model for every single request.'},
  {i:'🔐',h:'Key-secured',d:'Personal API keys with usage tracking and tunable limits.'},
];
document.getElementById('featGrid').innerHTML=FEATS.map(f=>`<div class="feat reveal"><div class="fi">${f.i}</div><h3>${f.h}</h3><p>${f.d}</p></div>`).join('');

// mcp tools
const MCP=[
  {i:'💬',h:'cdz_ask',d:'Ask any supermodel in one call.'},
  {i:'⚖️',h:'cdz_council',d:'Convene the multi-model Council.'},
  {i:'🖼️',h:'cdz_describe_image',d:'Describe any image from a URL.'},
  {i:'🎧',h:'cdz_transcribe_audio',d:'Transcribe audio from a URL.'},
  {i:'📄',h:'cdz_ocr',d:'Extract verbatim text from documents.'},
  {i:'🔎',h:'cdz_web_search',d:'Grounded web answers with citations.'},
];
document.getElementById('mcpGrid').innerHTML=MCP.map(f=>`<div class="feat reveal"><div class="fi">${f.i}</div><h3 style="font-family:'JetBrains Mono';font-size:15px">${f.h}</h3><p>${f.d}</p></div>`).join('');

// marquee
document.getElementById('mq').innerHTML=(()=>{const items=['CDZ Ultra','CDZ Council','CDZ Sage 4.8','CDZ Architect 5.5','CDZ Scholar 3.1','CDZ Flash 3.5','CDZ Polyglot 5.4','✦'];const row=items.map(x=>`<span>${x}</span>`).join('');return row+row;})();

// code tabs
const HOST='__HOST__';
const CODE={
  cURL:`<span class="c"># one endpoint, every model</span>
curl https://${HOST}/v1/chat/completions \\
  -H <span class="s">"Authorization: Bearer $CDZ_KEY"</span> \\
  -H <span class="s">"Content-Type: application/json"</span> \\
  -d <span class="s">'{"model":"cdz-ultra","messages":[{"role":"user","content":"Design my app"}]}'</span>`,
  Python:`<span class="k">from</span> openai <span class="k">import</span> OpenAI
client = OpenAI(base_url=<span class="s">"https://${HOST}/v1"</span>, api_key=<span class="s">"$CDZ_KEY"</span>)
r = client.chat.completions.create(
    model=<span class="s">"cdz-council"</span>,
    messages=[{<span class="s">"role"</span>:<span class="s">"user"</span>,<span class="s">"content"</span>:<span class="s">"Should we launch now?"</span>}],
)
<span class="k">print</span>(r.choices[0].message.content)`,
  Node:`<span class="k">import</span> OpenAI <span class="k">from</span> <span class="s">"openai"</span>;
