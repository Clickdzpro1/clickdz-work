# syntax=docker/dockerfile:1.7
#
# humanizily-backend — minimal replacement image for the broken `app` service.
#
# The static CI image ghcr.io/clickdzpro1/clickdz-work:stable-f28f6e8be is a
# complete, working artifact EXCEPT for one defect in the bundled
# `graphql-upload` package under Node 22:
#
#   The compiled server bundle calls a NAMED export:
#       (0, eP.graphqlUploadExpress)({ maxFileSize, maxFiles })
#   but `graphql-upload/graphqlUploadExpress.mjs` only provides a DEFAULT
#   export — there is NO named `graphqlUploadExpress` export. Under Node 22's
#   stricter ESM named-export enforcement the named import resolves to
#   `undefined`, so calling it throws at boot:
#       TypeError: (0 , eP.graphqlUploadExpress) is not a function
#
# Fix: rewrite the .mjs entry to capture the default export into a binding and
# re-export it as BOTH a named export (`graphqlUploadExpress`) and the default
# export, then point the package "exports" map at the patched entry. This is
# the same transformation the old `app` service used in its preDeployCommand —
# but a pre-deploy runs in an EPHEMERAL container and never persists into the
# running image. Baking it into the image is what actually fixes the runtime.
#
# Implementation note: we use plain string replace (not a regex) because the
# node -e one-liner goes through several escaping layers (Dockerfile -> shell
# -> node) that mangled a `\s` regex into a literal-backslash match. String
# matching on "export default" is escaping-safe.

# Bumped 2026-07-30: stable-f28f6e8be -> stable-22b7fe785 (built by tag
# image-stable-31 from commit 22b7fe7). The new base carries
# `bufferLogs: false`; without it a hang during NestFactory.create() yields a
# container with ZERO output, which is how the 2026-07-29 deploy failures
# presented and why they were undiagnosable.
#
# NOTE FOR FUTURE CHANGES: this image is NOT built from source at deploy time.
# Editing server source and pushing changes NOTHING in the running container.
# To ship a code change you must rebuild the base image (push an `image-*` tag
# to run build-clickdz-image.yml) and then bump this ARG to the new tag.
ARG BASE_IMAGE=ghcr.io/clickdzpro1/clickdz-work:stable-22b7fe785
FROM ${BASE_IMAGE}

RUN node -e "const f=require('fs');const m='/app/node_modules/graphql-upload/graphqlUploadExpress.mjs';if(!f.existsSync(m)){console.error('[patch] missing '+m);process.exit(1)}let s=f.readFileSync(m,'utf8');if(!s.includes('export const graphqlUploadExpress')){const i=s.indexOf('export default');if(i<0){console.error('[patch] no default export found');process.exit(1)}s=s.slice(0,i)+'const _g='+s.slice(i+14);s+='\nexport const graphqlUploadExpress=_g;\nexport default _g;\n';f.writeFileSync(m,s)}const pp='/app/node_modules/graphql-upload/package.json';const p=JSON.parse(f.readFileSync(pp,'utf8'));p.exports=p.exports||{};p.exports['.']={import:'./graphqlUploadExpress.mjs',default:'./graphqlUploadExpress.mjs'};f.writeFileSync(pp,JSON.stringify(p));console.log('[patch] graphql-upload named+default export baked in')"

# Inherit the base image's WORKDIR (/app), ENV (LD_PRELOAD), EXPOSE (3010) and
# CMD (`node ./scripts/cdz-ai-config.mjs; exec node ./dist/main.js`).
# Intentionally leave the Railway start command UNSET so this CMD is used and
# the CDZ provider bootstrap runs on every boot.
