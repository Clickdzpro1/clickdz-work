# syntax=docker/dockerfile:1.7
#
# humanizily-backend — minimal replacement image for the broken `app` service.
#
# The static CI image ghcr.io/clickdzpro1/clickdz-work:stable-f28f6e8be is a
# complete, working artifact EXCEPT for one defect: `graphql-upload` ships an
# ESM entry (graphqlUploadExpress.mjs) whose default export does not interop
# correctly under Node 22, crashing the server at import time.
#
# Rather than rebuild the whole monorepo from source on Railway (needs the
# custom `affine` CLI, native .node modules, prisma engine resolution, and the
# frontend dist/ artifacts — all of which CI already produced), we START from
# the known-good CI image and bake the ESM patch in at image-build time. This
# is the same patch the old service tried as a preDeployCommand, but a
# pre-deploy runs in an ephemeral container and does NOT persist into the
# running image — baking it into the image fixes that.

ARG BASE_IMAGE=ghcr.io/clickdzpro1/clickdz-work:stable-f28f6e8be
FROM ${BASE_IMAGE}

# Patch graphql-upload so its ESM default export interops under Node 22.
#  - rewrite graphqlUploadExpress.mjs: capture the default export into a
#    binding and re-export it as BOTH a named export (graphqlUploadExpress)
#    and the default export.
#  - normalize the package "exports" map so both `import` and `require`
#    resolve to the patched .mjs entry.
# Idempotent and fail-fast only if the file is genuinely missing.
RUN node -e '\
const f=require("fs");\
const m="/app/node_modules/graphql-upload/graphqlUploadExpress.mjs";\
if(!f.existsSync(m)){console.error("[patch] missing "+m);process.exit(1);}\
let s=f.readFileSync(m,"utf8");\
if(!s.includes("export const graphqlUploadExpress")){\
  s=s.replace(/export\\s+default/,"const _g=")+\
     "\\nexport const graphqlUploadExpress=_g;\\nexport default _g;\\n";\
  f.writeFileSync(m,s);\
}\
const p=JSON.parse(f.readFileSync("/app/node_modules/graphql-upload/package.json","utf8"));\
p.exports=p.exports||{};\
p.exports["."]={import:"./graphqlUploadExpress.mjs",default:"./graphqlUploadExpress.mjs"};\
f.writeFileSync("/app/node_modules/graphql-upload/package.json",JSON.stringify(p));\
console.log("[patch] graphql-upload ESM interop patched");\
'

# Inherit the base image's WORKDIR (/app), ENV (LD_PRELOAD), EXPOSE (3010) and
# CMD (`node ./scripts/cdz-ai-config.mjs; exec node ./dist/main.js`).
# Intentionally leave the Railway start command UNSET so this CMD is used and
# the CDZ provider bootstrap runs on every boot.
