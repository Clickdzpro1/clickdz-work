# ClickDz ERP — environment template. Copy to .env, fill, never commit filled.

# ERPNext image tag (official). Swap to a custom-built image later if we add
# custom apps to the Clickdzpro1/erpnext fork.
ERPNEXT_VERSION=v15

# public site name — must match the domain serving the ERP
ERP_SITE=erp.clickdz.ai

# port the frontend listens on (reverse proxy points here)
ERP_HTTP_PORT=8080

# secrets — generate strong values, keep only on the host
DB_ROOT_PASSWORD=<GENERATE_STRONG_PASSWORD>
ERP_ADMIN_PASSWORD=<GENERATE_STRONG_ADMIN_PASSWORD>
