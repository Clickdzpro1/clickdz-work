# ClickDz Work — self-host environment template
# Copy to .env and fill values. NEVER commit a filled .env.

# image tag built by the "Build ClickDz Work server image" workflow
CLICKDZ_REVISION=stable

# public entry
PORT=3010
AFFINE_SERVER_HTTPS=true
AFFINE_SERVER_HOST=work.clickdz.ai

# persistence paths on the host
UPLOAD_LOCATION=./data/storage
CONFIG_LOCATION=./data/config
DB_DATA_LOCATION=./data/postgres

# database credentials (generate a strong password)
DB_USERNAME=clickdzwork
DB_PASSWORD=<GENERATE_STRONG_PASSWORD>
DB_DATABASE=clickdzwork

# ---- AI (ClickDz AI / Copilot) ----
# Owner-only: set the real key in the host's env manager, never in git.
COPILOT_OPENAI_API_KEY=<OPENAI_API_KEY>
# Optional AI extras:
# COPILOT_FAL_API_KEY=<FAL_KEY>        # AI image generation
# COPILOT_EXA_API_KEY=<EXA_KEY>        # AI web search grounding
# COPILOT_ANTHROPIC_API_KEY=<KEY>      # Claude models in Copilot

# ---- Optional mailer (invites, magic links) ----
